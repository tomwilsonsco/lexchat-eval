# Build context for .devcontainer/Dockerfile. The context is the repo root and
# the Dockerfile does `COPY . .`, so anything not excluded here is copied into
# the image on every rebuild.
#
# Being aggressive is safe: devcontainer.json bind-mounts the workspace over
# /app at runtime, so the copied tree only has to be complete enough for
# `pip install -e ".[dev]"` to build the package (pyproject.toml + lex_eval/).
# Everything excluded below is still present at runtime via that mount.

# Databases. responses.db.
*.db
*.db.wal

# Capture artefacts, regenerated by gather_responses.py --debug-events /
# --verbose-capture.
lex_eval/data/debug_events.jsonl
lex_eval/data/verbose_logs/

# Live session transcript exports, which carry named reviewers. Never bake
# these into an image.
lex_eval/data/session-transcripts-*.csv

# Credentials. lex_eval/.env is read at runtime through the bind mount.
.env
*.env
!lex_eval/.env.example

# The LexChat clone is reference material only; the eval never imports from it.
LexChat/

# Version control and local tooling state.
.git/
.gitignore
.claude/

# Python build and cache artefacts.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.deepeval/
.ipynb_checkpoints/

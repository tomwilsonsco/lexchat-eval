# LexChat API Configuration
LEXCHAT_API=http://host.docker.internal:80

# Authentication
USERNAME=admin
PASSWORD=admin

# LEX API — used only by lex_eval/reference/ (building reference answers), not by
# gather_responses.py. Optional: defaults to https://lex.lab.i.ai.gov.uk if unset.
LEX_API_URL=https://lex.lab.i.ai.gov.uk
# TLS verification for the LEX API client. Off by default because the target
# deployment above sits behind SSL inspection; set to true for a normal HTTPS endpoint.
LEX_API_TLS_VERIFY=false

# OpenRouter judge (judge LLM for AI-as-judge metrics)
OPENROUTER_API_KEY=yourkeyhere
# Any OpenRouter model — openai/gpt-4o is the default, o4-mini for more thorough evals
OPENROUTER_JUDGE_MODEL=openai/gpt-4o
# Judge sampling temperature (0.0 = deterministic, default; higher = more varied)
# Most models accept 0.0–2.0; invalid values fall back to 0.0 with a warning.
OPENROUTER_JUDGE_TEMPERATURE=0.0
# Max tokens for a judge response. Raise if judge calls come back empty
# (reasoning-heavy models can exhaust this budget); invalid values fall back to 4096.
OPENROUTER_JUDGE_MAX_TOKENS=4096
# Optional reasoning effort passed to models that support it (e.g. "low", "medium", "high").
# Unset by default.
OPENROUTER_JUDGE_REASONING_EFFORT=
# Optional fallback model, used only if the primary judge model returns empty
# content twice in a row. Unset by default (no fallback).
OPENROUTER_JUDGE_FALLBACK_MODEL=

# Parallel pytest-xdist workers used by run_evals.py (mainly speeds up the
# AI-judge suites). Raise if your OpenRouter account handles more concurrent
# requests comfortably; lower if you see rate-limit errors. Override per-run
# with --workers.
EVAL_WORKERS=4

